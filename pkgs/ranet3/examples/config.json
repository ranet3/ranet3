{
  "node": "example/my-laptop",
  "auth": {
    "key": "/etc/ranet3/key.pem",
    "trust": "/etc/ranet3/trust.json"
  },
  "link": {
    "port": 13000,
    "endpoints": [{ "serial": "0", "family": "ip4" }]
  },
  "dial": {
    "to": ["example/gateway:0"]
  },
  "cap": {
    "route": { "announce": ["10.66.0.5/32"] },
    "babel": { "hello": "4s", "update": "16s" }
  }
}

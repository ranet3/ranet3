package ui

import "fmt"

// OG is a page's Open Graph image, 1200 by 630 in Noto Sans Mono on nord-0.
// The colors are written out, since resvg, which turns it into a PNG, reads
// no CSS variable.
templ OG(site Site, c Card) {
	<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630" font-family="Noto Sans Mono">
		<defs>
			<pattern id="dots" width="24" height="24" patternUnits="userSpaceOnUse">
				<circle cx="0" cy="0" r="1.5" fill="#3B4252"></circle>
				<circle cx="24" cy="0" r="1.5" fill="#3B4252"></circle>
				<circle cx="0" cy="24" r="1.5" fill="#3B4252"></circle>
				<circle cx="24" cy="24" r="1.5" fill="#3B4252"></circle>
			</pattern>
		</defs>
		<rect width="1200" height="630" fill="#2E3440"></rect>
		<rect width="1200" height="630" fill="url(#dots)"></rect>
		// the mark again, large and faint behind the text
		<svg x="600" y="-65" width="760" height="760" viewBox="0 0 100 100">
			<path d={ orbitOuter } fill="none" stroke="#3B4252" stroke-width="1.2" stroke-linecap="round"></path>
			<circle cx="82.7" cy="20.6" r="1.8" fill="#4C566A"></circle>
			<path d={ orbitInner } fill="none" stroke="#434C5E" stroke-width="1.4" stroke-linecap="round"></path>
			<circle cx="30.2" cy="69.8" r="1.8" fill="#4C566A"></circle>
			<circle cx="50" cy="50" r="3.4" fill="#88C0D0" fill-opacity=".85"></circle>
		</svg>
		<svg x="72" y="64" width="44" height="44" viewBox="0 0 100 100">
			@mark("#8D929A", "#ECEFF4", "#88C0D0")
		</svg>
		<text x="130" y="97.6" font-size="30" font-weight="700" fill="#ECEFF4">{ site.Name }</text>
		if c.Label != "" {
			<text x="72" y="201.7" font-size="24" font-weight="700" letter-spacing="1.92" fill="#88C0D0">{ c.Label }</text>
		}
		<text font-size={ fmt.Sprint(c.Size) } font-weight="700" fill="#ECEFF4">
			for i, l := range c.Lines {
				<tspan x="72" y={ c.titleY(i) }>{ l }</tspan>
			}
		</text>
		<text font-size={ fmt.Sprint(leadSize) } fill="#D8DEE9">
			for i, l := range c.Lead {
				<tspan x="72" y={ c.leadY(i) }>{ l }</tspan>
			}
		</text>
		if c.Meta != "" {
			<text x="72" y="571.6" font-size="22" fill="#D8DEE9">{ c.Meta }</text>
		}
	</svg>
}

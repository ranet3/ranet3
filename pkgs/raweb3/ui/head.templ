package ui

// Head is the inside of a page's head element. Children go after the metas
// and before the analytics script.
templ Head(site Site, page Page) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<title>{ page.Title }</title>
	<meta name="description" content={ page.Description }/>
	if page.Path != "" {
		<meta name="robots" content="index, follow"/>
		<link rel="canonical" href={ templ.SafeURL(site.URL + page.Path) }/>
	} else {
		<meta name="robots" content="noindex"/>
	}
	<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
	<meta name="theme-color" content="#2E3440" media="(prefers-color-scheme: dark)"/>
	<meta name="theme-color" content="#ECEFF4" media="(prefers-color-scheme: light)"/>
	<meta name="color-scheme" content="light dark"/>
	<meta property="og:type" content="website"/>
	<meta property="og:site_name" content={ site.Name }/>
	<meta property="og:title" content={ page.Title }/>
	<meta property="og:description" content={ page.Description }/>
	if page.Path != "" {
		<meta property="og:url" content={ site.URL + page.Path }/>
	}
	<meta name="twitter:card" content="summary"/>
	<meta name="twitter:title" content={ page.Title }/>
	<meta name="twitter:description" content={ page.Description }/>
	for _, m := range site.Metas {
		<meta name={ m.Name } content={ m.Content }/>
	}
	{ children... }
	<script defer data-domain={ site.Analytics.Domain } src={ site.Analytics.Src }></script>
}

// Mark is the logo drawn small, the core node and its 2 orbits, size pixels square.
templ Mark(size int) {
	<svg viewBox="0 0 100 100" width={ size } height={ size } aria-hidden="true" class="block flex-none">
		<path d="M90.8 33.5 A44 44 0 1 1 70.7 11.2" style="fill:none;stroke:var(--mute);stroke-width:6;stroke-linecap:round"></path>
		<circle cx="82.7" cy="20.6" r="7" style="fill:var(--fg)"></circle>
		<path d="M24.6 61.8 A28 28 0 1 1 38.2 75.4" style="fill:none;stroke:var(--fg);stroke-width:7;stroke-linecap:round"></path>
		<circle cx="30.2" cy="69.8" r="7" style="fill:var(--fg)"></circle>
		<circle cx="50" cy="50" r="12" style="fill:var(--acc)"></circle>
	</svg>
}

// ASCIIMark is the logo drawn in text, as large as the font size it inherits.
templ ASCIIMark() {
	<pre class="m-0 cursor-default text-left leading-none text-fg select-none" role="img" aria-label="The ranet3 logo, a core node inside 2 broken orbits, each carrying a peer">
		@templ.Raw(asciiMark)
	</pre>
}

// asciiMark is the art of ASCIIMark, markup in a string since templ collapses
// the whitespace of a pre's text
const asciiMark = `
              <span class="text-mute">..::----::..</span>
          <span class="text-mute">.:-++++++++++++++-:.</span>
        <span class="text-mute">:=+++-:..      ..:-+++=:</span>
      <span class="text-mute">:=++-.                .-+-.</span>
    <span class="text-mute">.=++-.</span>       ::::::       <span class="text-mute">.</span>   .::.
   <span class="text-mute">:++=.</span>     :+#@@@@@@@@#+:      *@@@@=
  <span class="text-mute">:++=</span>     -#@@%*+-::-+*%@@#-   :@@@@@@
 <span class="text-mute">.++=</span>    .*@@#-          -#@@*. .#@@@@*
 <span class="text-mute">-++.</span>   .#@@=              =@@#.  -++:
<span class="text-mute">.++-</span>    *@@-      <span class="text-acc">:++:</span>      -@@*
<span class="text-mute">:++.</span>   .@@#     <span class="text-acc">-%@@@@%-</span>     #@@.   <span class="text-mute">.--:</span>
<span class="text-mute">-++</span>    .++:     <span class="text-acc">%@@@@@@%</span>     +@@:    <span class="text-mute">++-</span>
<span class="text-mute">-++</span>             <span class="text-acc">%@@@@@@%</span>     +@@:    <span class="text-mute">++-</span>
<span class="text-mute">:++.</span>    .=+-.   <span class="text-acc">-%@@@@%-</span>     #@@.   <span class="text-mute">.++:</span>
<span class="text-mute">.++-</span>   :%@@@%:    <span class="text-acc">:++:</span>      -@@*    <span class="text-mute">-++.</span>
 <span class="text-mute">-++.</span>  =@@@@@=             =@@#.   <span class="text-mute">.++-</span>
 <span class="text-mute">.++=</span>   +%@%+            -#@@*.    <span class="text-mute">=++.</span>
  <span class="text-mute">:++=</span>         =*+-::-+*%@@#-     <span class="text-mute">=++:</span>
   <span class="text-mute">:++=.</span>      .#@@@@@@@@#+:     <span class="text-mute">.=++:</span>
    <span class="text-mute">.=++-.</span>       ::::::       <span class="text-mute">.-++=.</span>
      <span class="text-mute">:=++-.                .-++=:</span>
        <span class="text-mute">:=+++-:..      ..:-+++=:</span>
          <span class="text-mute">.:-++++++++++++++-:.</span>
              <span class="text-mute">..::----::..</span>
`

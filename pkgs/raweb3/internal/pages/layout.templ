package pages

import "ranet3.com/pkgs/raweb3/ui"

// frame is every page around its content: the head, the header, the notice
// on a page no person has read in full since it last changed, and the footer.
templ frame(site ui.Site, page ui.Page, unvetted bool, body string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@ui.Head(site, page) {
				<link rel="stylesheet" href="/style.css"/>
				@themeScript()
			}
		</head>
		<body class={ "bg-bg text-fg2 antialiased", body }>
			@bar(site)
			if unvetted {
				@notice()
			}
			{ children... }
			@footer(site)
		</body>
	</html>
}

// bar is one row. Below sm the links and the switch move into a menu, a
// popover sheet over the top of the page that repeats the logo row with a
// close button where the menu button was. A browser without popover support
// shows the sheet as a block under the bar.
templ bar(site ui.Site) {
	<header class="border-b border-line font-mono text-[15px]">
		<nav class="mx-auto flex max-w-6xl items-center gap-x-7 px-4 py-4 md:px-6">
			@brand(site)
			<div class="flex gap-x-7 max-sm:hidden">
				for _, l := range site.Nav {
					<a href={ templ.SafeURL(l.Href) } class="whitespace-nowrap text-fg2 hover:text-acc">{ l.Title }</a>
				}
			</div>
			<div class="contents max-sm:hidden">
				@themeSwitch()
			</div>
			@menuButton("show", "Menu", "sm:hidden") {
				<path d="M4 7h16M4 12h16M4 17h16"></path>
			}
		</nav>
		<div id="menu" popover class="inset-x-0 top-0 bottom-auto m-0 w-full border-0 border-b border-line bg-bg p-0 text-fg2 backdrop:bg-bg/70 sm:hidden">
			<div class="flex items-center px-4 py-4">
				@brand(site)
				@menuButton("hide", "Close menu", "") {
					<path d="M6 6l12 12M18 6L6 18"></path>
				}
			</div>
			<div class="flex flex-col border-t border-line px-4">
				for _, l := range site.Nav {
					<a href={ templ.SafeURL(l.Href) } class="border-b border-line py-3 text-fg hover:text-acc">{ l.Title }</a>
				}
			</div>
			<div class="hidden items-center justify-between px-4 py-3 scripted:flex">
				// the group carries the same name for assistive tech
				<span class="text-fg" aria-hidden="true">Theme</span>
				@themeSwitch()
			</div>
		</div>
	</header>
}

// brand is the logo link, as tall as the theme switch and the menu button, so
// the bar keeps one height at every width and with or without the script.
templ brand(site ui.Site) {
	<a href="/" class="mr-auto flex h-7.5 items-center gap-2.5 text-[17px] font-bold text-fg">
		@ui.Mark(26)
		<span>{ site.Name }</span>
	</a>
}

// menuButton opens or closes the menu, sized and drawn as the theme switch's
// buttons are.
templ menuButton(action, title, class string) {
	<button type="button" class={ "border border-line p-1.5 text-fg2 hover:text-fg", class } popovertarget="menu" popovertargetaction={ action }>
		<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="block" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			{ children... }
		</svg>
		<span class="sr-only">{ title }</span>
	</button>
}

// themeSwitch picks the light or dark scheme, or auto to follow the system.
// It shows, with the pick marked, once themeScript sets data-theme.
templ themeSwitch() {
	<div class="hidden shrink-0 border border-line scripted:flex" role="group" aria-label="Theme">
		@themeChoice("light", "Light") {
			<circle cx="12" cy="12" r="4"></circle>
			<path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
		}
		@themeChoice("auto", "Auto") {
			<circle cx="12" cy="12" r="9"></circle>
			<path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor"></path>
		}
		@themeChoice("dark", "Dark") {
			<path d="M20 14.5A8.5 8.5 0 0 1 9.5 4 8.5 8.5 0 1 0 20 14.5z"></path>
		}
	</div>
}

templ themeChoice(theme, title string) {
	<button type="button" class="p-1.5 text-mute hover:text-fg picked:bg-bg2 picked:text-acc" data-theme-choice={ theme } aria-pressed="false" title={ title }>
		<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="block" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			{ children... }
		</svg>
		<span class="sr-only">{ title }</span>
	</button>
}

// themeScript runs in the head before the body exists, so a stored theme
// applies, and the switch shows with its pick marked, before the page paints.
// A browser that runs no script, or keeps no storage, follows the system's
// scheme.
templ themeScript() {
	<script>
		(() => {
			const key = "theme";
			const root = document.documentElement;
			// the browser bar takes the chosen scheme's color too
			const metas = [...document.querySelectorAll('meta[name="theme-color"]')]
				.map((m) => [m, m.media]);

			const stored = () => {
				try {
					return localStorage.getItem(key);
				} catch {
					return null;
				}
			};

			const store = (theme) => {
				try {
					if (theme === "auto") localStorage.removeItem(key);
					else localStorage.setItem(key, theme);
				} catch {
					// the choice then lasts until the page closes
				}
			};

			const apply = (theme) => {
				const fixed = theme === "light" || theme === "dark";
				root.dataset.theme = fixed ? theme : "auto";
				for (const [m, media] of metas) {
					m.media = !fixed ? media : media.includes(theme) ? "all" : "not all";
				}
			};

			const mark = () => {
				const theme = root.dataset.theme;
				for (const b of document.querySelectorAll("[data-theme-choice]")) {
					b.setAttribute("aria-pressed", String(b.dataset.themeChoice === theme));
				}
			};

			apply(stored());

			// another tab of the site changed the theme
			addEventListener("storage", (e) => {
				if (e.key === key || e.key === null) {
					apply(stored());
					mark();
				}
			});

			addEventListener("DOMContentLoaded", () => {
				for (const b of document.querySelectorAll("[data-theme-choice]")) {
					b.addEventListener("click", () => {
						store(b.dataset.themeChoice);
						apply(b.dataset.themeChoice);
						mark();
					});
				}
				mark();
			});
		})();
	</script>
}

// footer ends every page, full width below the content.
templ footer(site ui.Site) {
	<footer class="mt-16 bg-bg2 font-mono text-[15px] leading-[1.55]">
		<div class="mx-auto max-w-6xl px-4 py-12 md:px-6">
			<div class="flex flex-wrap items-center gap-6 max-sm:flex-col max-sm:text-center">
				<p class="text-[24px] leading-tight font-bold text-balance text-fg sm:mr-auto">{ site.Footer.Title }</p>
				<a href={ templ.SafeURL(site.CTA.Href) } class="btn-primary">{ site.CTA.Title }</a>
			</div>
			<dl class="mt-10 grid gap-10 border-t border-line pt-10 sm:grid-cols-2 lg:grid-cols-4">
				@facts(site.Footer.Stack)
			</dl>
			<dl class="mt-10 grid gap-x-10 gap-y-6 border-t border-line pt-8 text-[13px] sm:grid-cols-2 lg:grid-cols-4">
				@facts(site.Footer.Project)
			</dl>
		</div>
	</footer>
}

templ facts(fs []ui.Fact) {
	for _, f := range fs {
		<div class="flex flex-col gap-2">
			<dt class="label">{ f.Label }</dt>
			<dd class="text-fg">
				for i, p := range f.Parts {
					if i > 0 {
						{ " " }
					}
					@part(p)
				}
			</dd>
		</div>
	}
}

templ part(p ui.Part) {
	if p.Cite {
		<span class="text-mute">({ "" }<a href={ templ.SafeURL(p.Href) } class="link whitespace-nowrap">{ p.Text }</a>{ "" })</span>
	} else if p.Href != "" {
		<a href={ templ.SafeURL(p.Href) } class="link">{ p.Text }</a>
	} else {
		{ p.Text }
	}
}

templ notice() {
	<p class="bg-warn px-4 py-2 text-center font-mono text-sm text-bg" role="note">This page may contain unreviewed machine generated text. Use with care.</p>
}

// Bare is a page whose markdown lays itself out, full width.
templ Bare(site ui.Site, c Content) {
	@frame(site, ui.Page{Title: pageTitle(site, c), Description: c.Description, Path: c.Path}, c.Unvetted, "font-mono") {
		<main>
			@templ.Raw(c.Body)
		</main>
	}
}

// pageTitle is a page's title with the site's name after it, the site's name
// alone on the front page.
func pageTitle(site ui.Site, c Content) string {
	if c.Path == "/" {
		return c.Title
	}
	return c.Title + " | " + site.Name
}

package pages

import (
	"time"

	"ranet3.com/pkgs/raweb3/ui"
)

// Docs is one docs page.
templ Docs(site ui.Site, doc Content) {
	@frame(site, ui.Page{Title: docsTitle(site, doc), Description: doc.Description, Path: doc.Path, Image: doc.Image}, doc.Unvetted, "") {
		<div class="mx-auto flex max-w-6xl gap-12 px-4 md:px-6">
			<nav class="hidden w-56 shrink-0 py-10 md:block" aria-label="Docs">
				@navList(doc.Nav)
			</nav>
			<main id="main" class="min-w-0 flex-1 py-10">
				<details class="mb-8 border-b border-line pb-4 md:hidden">
					<summary class="cursor-pointer font-mono text-sm text-fg">Pages</summary>
					<nav class="mt-4" aria-label="Docs">
						@navList(doc.Nav)
					</nav>
				</details>
				<article class="prose prose-theme max-w-3xl">
					<h1 class="font-mono">{ doc.Title }</h1>
					<p class="lead">{ doc.Description }</p>
					@templ.Raw(doc.Body)
				</article>
				<p class="mt-12 font-mono text-sm text-mute">Updated <time datetime={ doc.Updated.Format(time.DateOnly) }>{ doc.Updated.Format(time.DateOnly) }</time></p>
			</main>
		</div>
	}
}

templ navList(nav []Section) {
	for _, s := range nav {
		<div class="mb-6 font-mono text-sm">
			if s.Title != "" {
				<p class="mb-2 text-mute">{ s.Title }</p>
			}
			<ul class="space-y-1">
				for _, l := range s.Links {
					<li>
						if l.Current {
							<a href={ templ.SafeURL(l.Path) } aria-current="page" class="-ml-2.5 border-l-2 border-acc pl-2 font-bold text-fg">{ l.Title }</a>
						} else {
							<a href={ templ.SafeURL(l.Path) } class="text-fg2 hover:text-acc">{ l.Title }</a>
						}
					</li>
				}
			</ul>
		</div>
	}
}

// docsTitle is the title of a docs page, the docs alone for the docs' own
// front page.
func docsTitle(site ui.Site, doc Content) string {
	if doc.Path == "/docs/" {
		return site.Name + " docs"
	}
	return doc.Title + " | " + site.Name + " docs"
}

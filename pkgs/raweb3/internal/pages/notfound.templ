package pages

import "ranet3.com/pkgs/raweb3/ui"

// NotFound is the page for every path the site has no page at.
templ NotFound(site ui.Site) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@ui.Head(site, ui.Page{Title: "Not found | " + site.Name, Description: "No page at this address."}) {
				<link rel="stylesheet" href="/style.css"/>
			}
		</head>
		<body class="bg-bg text-fg2 antialiased">
			@bar(site)
			<main class="mx-auto max-w-6xl px-4 py-16 font-mono">
				<h1 class="text-2xl font-bold text-fg">Not found</h1>
				<p class="mt-4">No page at this address. See the <a href="/" class="text-acc underline decoration-accl underline-offset-4 hover:decoration-current">front page</a> or the <a href="/docs/" class="text-acc underline decoration-accl underline-offset-4 hover:decoration-current">docs</a>.</p>
			</main>
		</body>
	</html>
}
